# YottaFlex AI Collections Platform - Environment Configuration Example
# Copy to .env for local overrides (never commit secrets to version control)

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Relational Database
DATABASE_URL=sqlite:///./backend/hackathon.db

# Synthetic Data Generation
DEFAULT_SEED=20261022
DEFAULT_SCALE=full
TARGET_LOANS=10000
TARGET_INSTALLMENTS=30000

# Statutory Contact Rules (FDCPA / TCPA)
DEFAULT_CONTACT_WINDOW_START=09:00:00
DEFAULT_CONTACT_WINDOW_END=18:00:00
MAX_WEEKLY_VOICE_ATTEMPTS=3

